{
  "name": "billy-note",
  "private": true,
  "license": "MIT",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit",
    "tauri": "tauri",
    "app": "tauri dev",
    "build:mac": "TAURI_SIGNING_PRIVATE_KEY=\"$HOME/.tauri/billy-note.key\" TAURI_SIGNING_PRIVATE_KEY_PASSWORD= tauri build --bundles app,dmg",
    "build:win": "tauri build --bundles nsis",
    "icons": "node scripts/make-icon.mjs && tauri icon src-tauri/icons/source.png",
    "bump": "node scripts/bump.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
